#!/bin/sh
# Mallet CLI wrapper script

# Find the script directory
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR=$(cd "$(dirname "$SCRIPT")" && pwd)
  SCRIPT=$(readlink "$SCRIPT")
  case "$SCRIPT" in
    /*) ;;
    *) SCRIPT="$SCRIPT_DIR/$SCRIPT" ;;
  esac
done
PROJECT_DIR=$(cd "$(dirname "$SCRIPT")/.." && pwd)

if [ -f "$PROJECT_DIR/.qlot/setup.lisp" ]; then
  SETUP_FILE="$PROJECT_DIR/.qlot/setup.lisp"
elif [ -f "$PROJECT_DIR/.bundle-libs/setup.lisp" ]; then
  SETUP_FILE="$PROJECT_DIR/init.lisp"
else
  echo "Mallet is not setup yet." >&2
  exit 1
fi

# Run with SBCL.
#
# Only the linter's own records belong on stdout, so a caller can pipe them into another
# program. Everything the setup and the system load have to say is a diagnostic and goes to
# stderr instead. The redirection covers both setup branches, because which branch runs is
# decided by what happens to be installed and the output contract must not depend on that.
#
# stderr is deliberately left alone: a setup that fails silently is a worse fault than
# chatter in the wrong place, so this moves the noise rather than discarding it.
#
# The init files are skipped so the linter's output depends on the project alone. A personal
# ~/.sbclrc is free to load whatever it likes and print while doing it, and that lands on
# stdout ahead of anything mallet controls. Dependencies come from the setup file below.
exec sbcl --noinform --non-interactive --no-sysinit --no-userinit \
    --eval '(defparameter *mallet-program-output* *standard-output*)' \
    --eval '(setf *standard-output* *error-output* *trace-output* *error-output*)' \
    --load "$SETUP_FILE" \
    --eval "(when (find-package '#:qlot/local-init/setup) (setf (symbol-value (find-symbol \"*PROJECT-ROOT*\" '#:qlot/local-init/setup)) #p\"$PROJECT_DIR/\"))" \
    --eval '(asdf:load-system :mallet)' \
    --eval '(setf *standard-output* *mallet-program-output*)' \
    --eval "(mallet:main)" -- "$@"
